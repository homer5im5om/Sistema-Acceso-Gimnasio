-- ==========================================
-- REQUISITO: Al menos 2 Catálogos
-- ==========================================

-- Catálogo 1: Roles (Admin, Socio, Entrenador)
CREATE TABLE Rol (
    id_rol INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    descripcion TEXT NOT NULL
);

-- Catálogo 2: Estado de la Membresía (Activo, Vencido)
CREATE TABLE EstadoMembresia (
    id_estado INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    descripcion TEXT NOT NULL
);

-- ==========================================
-- REQUISITO: Tabla Principal conectada a Catálogos (Claves Foráneas)
-- ==========================================

CREATE TABLE Usuario (
    id_usuario INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    password TEXT NOT NULL,
    qr_token TEXT NOT NULL UNIQUE,
    id_rol INTEGER NOT NULL,
    id_estado INTEGER NOT NULL,
    FOREIGN KEY (id_rol) REFERENCES Rol(id_rol),
    FOREIGN KEY (id_estado) REFERENCES EstadoMembresia(id_estado)
);

-- ==========================================
-- REQUISITO: Registro que genera bitácora (Múltiples tablas)
-- ==========================================

CREATE TABLE BitacoraAcceso (
    id_bitacora INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    id_usuario INTEGER NOT NULL,
    fecha_hora TEXT NOT NULL,
    acceso_permitido INTEGER NOT NULL, -- 1 para sí (Activo), 0 para no (Vencido)
    FOREIGN KEY (id_usuario) REFERENCES Usuario(id_usuario)
);

-- ==========================================
-- REQUISITO: Consultas CRUD Completas
-- ==========================================

-- INSERTAR USUARIO (Se actualizó para incluir el estado de membresía)
insertarUsuario:
INSERT INTO Usuario (nombre, password, qr_token, id_rol, id_estado)
VALUES (?, ?, ?, ?, ?);

buscarPorToken:
SELECT *
FROM Usuario
WHERE qr_token = ?;

verificarLogin:
SELECT *
FROM Usuario
WHERE nombre = ? AND password = ?;

obtenerTodosLosUsuarios:
SELECT *
FROM Usuario;

-- QUERIES PARA LA BITÁCORA (Nos servirá para los reportes después)
registrarAcceso:
INSERT INTO BitacoraAcceso (id_usuario, fecha_hora, acceso_permitido)
VALUES (?, ?, ?);

-- Esta consulta une la bitácora con el nombre del usuario para el Excel/PDF
obtenerHistorialAccesos:
SELECT BitacoraAcceso.id_bitacora, Usuario.nombre, BitacoraAcceso.fecha_hora, BitacoraAcceso.acceso_permitido
FROM BitacoraAcceso
INNER JOIN Usuario ON BitacoraAcceso.id_usuario = Usuario.id_usuario
ORDER BY BitacoraAcceso.fecha_hora DESC;

-- Consultas para llenar los catálogos
insertarRol:
INSERT OR IGNORE INTO Rol (id_rol, descripcion) VALUES (?, ?);

insertarEstado:
INSERT OR IGNORE INTO EstadoMembresia (id_estado, descripcion) VALUES (?, ?);

contarRoles:
SELECT COUNT(*) FROM Rol;